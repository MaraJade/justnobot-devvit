{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "thejustnobotmigrate",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Mop comments",
        "description": "Remove this comment and all child comments. This might take a few seconds to run.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-comment"
      },
      {
        "label": "Mop post comments",
        "description": "Remove all comments of this post. This might take a few seconds to run.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-post"
      },
      {
        "label": "Subscribe to OP",
        "description": "Subscribe to this post's author to get notified when they post",
        "location": "post",
        "forUserType": "user",
        "endpoint": "/internal/menu/subscribe"
      },
      {
        "label": "Unsubscribe from OP",
        "description": "Unsubscribe from this post's author",
        "location": "post",
        "forUserType": "user",
        "endpoint": "/internal/menu/unsubscribe"
      }
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit",
    "subscribe": "/internal/form/subscribe",
    "unsubscribe": "/internal/form/unsubscribe"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "dev": {
    "subreddit": "thejustnobotmigr_dev2"
  }
}